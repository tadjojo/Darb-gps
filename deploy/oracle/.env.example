# Copy this file to .env and chmod 600 .env. Never commit real values.
DARB_IMAGE_TAG=main

# DNS A record for this name must point to the Oracle VM public IPv4 address.
DARB_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# Use the Supabase Postgres connection string from Project Settings > Database.
# If direct connection is not reachable over IPv4, use the Supabase session pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Include every real frontend origin, comma-separated.
CORS_ORIGINS=https://tadjojo.github.io/Darb-gps,https://darb-gps-web.onrender.com
