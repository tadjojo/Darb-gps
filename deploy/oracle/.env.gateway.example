# Copy to .env.gateway only after a real device is enrolled and carrier ranges are known.
DARB_API_BASE_URL=https://api.example.com/api/v1
GT06_PORT=5023
NMEA_PORT=5024

# Replace with the actual APN/VPN egress CIDR(s). Never use 0.0.0.0/0.
TRUSTED_DEVICE_CIDRS=REPLACE_WITH_REAL_CARRIER_CIDR

# Replace the sample IMEI and token with the one-time values from DARB enrollment.
GT06_DEVICE_MAP_JSON={"123456789012345":{"bearerToken":"REPLACE_WITH_REAL_DEVICE_CREDENTIAL","sourceCidrs":["REPLACE_WITH_DEVICE_SOURCE_CIDR/32"]}}

# Optional NMEA device map. Use static, carrier-confirmed source IPv4 addresses.
# NMEA_DEVICE_MAP_JSON={}

MAX_CONNECTIONS=500
LOGIN_TIMEOUT_MS=15000
IDLE_TIMEOUT_MS=120000
