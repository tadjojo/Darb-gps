# Copy to .env and replace every placeholder. Never commit .env.
DARB_API_BASE_URL=https://darb-gps-x.onrender.com/api/v1
GT06_PORT=5023
NMEA_PORT=5024

# Replace with actual carrier/APN/VPN egress CIDRs.
# Do not use 0.0.0.0/0. The application rejects it.
TRUSTED_DEVICE_CIDRS=203.0.113.0/24

# Replace the example IMEI and credential with a real enrolled GT06 device.
# The bearerToken is a one-time credential generated by DARB enrollment.
GT06_DEVICE_MAP_JSON={"123456789012345":{"bearerToken":"REPLACE_WITH_REAL_DEVICE_BEARER_TOKEN_MINIMUM_32_CHARS","sourceCidrs":["203.0.113.41/32"]}}

# Optional. Add one entry per NMEA device with its static source IPv4 address.
# NMEA_DEVICE_MAP_JSON={}

MAX_CONNECTIONS=500
IDLE_TIMEOUT_MS=120000
